<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Boot Bitch</vendor>
  <vendor_url>https://github.com/CaptainMorgan12/Boot_Bitch</vendor_url>
  <icon_name>org.bootrepair.BootRepair</icon_name>

  <!-- A dedicated action for the privileged helper so the pkexec/Polkit
       authorization prompt shows this friendly, stable message instead of the
       generic org.freedesktop.policykit.exec prompt that renders the raw
       command line. The org.freedesktop.policykit.exec.path annotation makes
       pkexec select this action when the installed helper is the program being
       executed; the GUI invokes the installed helper directly (no /bin/bash
       indirection) so the annotation matches. Authorization defaults are
       identical to the generic exec action (administrator authentication every
       time), so this changes only the prompt wording, never the security
       policy. -->
  <action id="org.bootrepair.BootRepair.helper">
    <description>Run Boot Bitch system diagnostics and repair</description>
    <message>Authentication is required to run Boot Bitch system diagnostics and repair</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/boot-repair/boot-repair-helper</annotate>
  </action>
</policyconfig>
