+        part="$(efi_entry_partuuid_line "$line")"
+        [[ "$part" == "$partuuid" ]] || continue
+        loader="$(efi_entry_loader_line "$line" || true)"
+        [[ "${loader,,}" == "$wanted_loader" ]] || continue
+        id="$(efi_entry_id_line "$line")"
+        [[ -n "$id" ]] && printf '%s\n' "$id"
