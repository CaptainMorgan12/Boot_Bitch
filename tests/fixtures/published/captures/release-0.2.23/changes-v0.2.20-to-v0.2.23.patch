+efi_entry_ids_for_partuuid_loader()
+{
+    local partuuid="${1,,}" wanted_loader="${2,,}" line part loader id
+    command -v efibootmgr >/dev/null 2>&1 || return 1
+    [[ -n "$partuuid" && -n "$wanted_loader" ]] || return 1
