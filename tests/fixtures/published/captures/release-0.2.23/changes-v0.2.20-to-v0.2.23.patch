+    [[ "$path" == /* ]] || fail "Repair-system paths must be absolute: $path"
+    [[ "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* ]] \
+        || fail "Paths containing line breaks or tabs are not supported."
